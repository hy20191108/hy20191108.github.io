{
  "name": "haruhiko-yoshioka-homepage",
  "private": true,
  "engines": {
    "node": ">=24.8.0 <25"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2",
    "lint:styles": "stylelint '_sass/**/*.scss' --max-warnings 0",
    "lint:html": "html-validate '_site/**/*.html'",
    "lint": "bun run format:check && bun run lint:markdown && bun run lint:styles",
    "check": "bun run lint && bundle exec standardrb && bundle exec jekyll build && bundle exec ruby _scripts/check_llms.rb && bun run lint:html",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@shopify/prettier-plugin-liquid": "1.11.0",
    "html-validate": "11.14.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0"
  },
  "packageManager": "bun@1.4.4"
}
